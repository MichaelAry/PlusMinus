{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PlusMinus Studio 5",
  "version": "5.0.0",
  "identifier": "dev.plusminus.studio",
  "build": {
    "beforeDevCommand": "npm run dev:ui",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:ui",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PlusMinus Studio 5 / Graphite Research",
        "width": 1480,
        "height": 920,
        "minWidth": 900,
        "minHeight": 600,
        "backgroundColor": "#101214"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "externalBin": [
      "binaries/plusminus_runner",
      "binaries/plusminus_native_tests"
    ],
    "resources": [
      "binaries/source-fingerprint.json"
    ]
  }
}
